# ==================================================
# CEREBRO: openai | anthropic
# ==================================================
LLM_PROVIDER=openai

OPENAI_API_KEY=tu_clave_aqui
OPENAI_MODEL=gpt-5

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# 1 = si Claude rechaza una solicitud, la API reintenta con otro modelo
ANTHROPIC_FALLBACKS=1

# Pasos máximos que un agente puede dar por tarea
MAX_AGENT_STEPS=12

# ==================================================
# SEGURIDAD: confirmar_peligroso | confirmar_todo | autonomo
# ==================================================
SAFETY_MODE=confirmar_peligroso

# ==================================================
# IDENTIDAD
# ==================================================
ASSISTANT_NAME=JARVIS
USER_NAME=Yael

# ==================================================
# TRELLO  (https://trello.com/power-ups/admin -> API key -> Token)
# ==================================================
TRELLO_API_KEY=
TRELLO_TOKEN=
# Minutos entre revisiones de pendientes (0 = sin avisos automáticos)
TRELLO_CHECK_MINUTES=30

# ==================================================
# CANVA  (opcional: token OAuth de Canva Connect API)
# Sin token, YAELCORE abre las plantillas de Canva en el navegador.
# ==================================================
CANVA_ACCESS_TOKEN=

# ==================================================
# MENCIONES EN GRUPOS (Telegram)
# Crea un bot con @BotFather, desactiva su privacidad (/setprivacy -> Disable)
# y agrégalo a tus grupos.
# ==================================================
TELEGRAM_BOT_TOKEN=
MENTION_HANDLE=@YaelCS
